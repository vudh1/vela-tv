<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="https://github.com/vudh1/vela-tv/samsung"
        version="2.6.0"
        viewmodes="maximized">
    <tizen:application id="VelaTv0001.VelaTV" package="VelaTv0001" required_version="5.5"/>
    <tizen:profile name="tv"/>
    <tizen:setting screen-orientation="landscape" context-menu="disable" background-support="disable" encryption="disable" install-location="auto" hwkey-event="enable"/>
    <tizen:privilege name="http://tizen.org/privilege/appmanager.launch"/>
    <content src="index.html"/>
    <icon src="icon.png"/>
    <name>Vela TV</name>
    <description>Quiet TV dashboard for Samsung Tizen</description>
</widget>
